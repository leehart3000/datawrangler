{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/London",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Python itself is tracked via .python-version and the Docker images",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "uv installed with pip in .gitlab-ci.yml",
      "managerFilePatterns": ["/^\\.gitlab-ci\\.yml$/"],
      "matchStrings": ["pip install --quiet uv==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Tailwind standalone CLI in the Dockerfile (same version numbers as the npm package)",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["tailwindcss/releases/download/v(?<currentValue>[0-9.]+)/"],
      "depNameTemplate": "tailwindcss",
      "datasourceTemplate": "npm"
    }
  ]
}